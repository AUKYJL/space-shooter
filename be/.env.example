## SpaceShooter backend env example
## Copy to `.env` and adjust for your local Postgres (without Docker).
##
## Example:
##   cp .env.example .env

# HTTP port (optional)
BE_PORT=4000

# Required
JWT_SECRET=dev_secret_change_me

POSTGRES_USER=postgres
POSTGRES_PASSWORD=123456
POSTGRES_DB=space_shooter

# Required
# Local Postgres example (default local port 5432):
DATABASE_URL=postgresql://space_shooter:space_shooter@127.0.0.1:5432/space_shooter?schema=public
